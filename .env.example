# Required. Your Anthropic API key. Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional. Claude model used for writing. Defaults to claude-sonnet-5-5.
LAHJA_MODEL=claude-sonnet-5-5

# Optional. low | medium | high. Lower is faster; low keeps requests well inside function time limits.
LAHJA_EFFORT=low
